# MedConnect Backend Environment Configuration
PORT=5000
NODE_ENV=production

# Supabase / PostgreSQL Connection
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication
JWT_SECRET=medconnect_karavali_super_secret_jwt_key_2026

# Google Gemini AI API Key (Server-Side)
GEMINI_API_KEY=your_google_gemini_api_key
